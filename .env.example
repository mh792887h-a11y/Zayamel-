# =====================================================================
# تطبيق زوامل اليمن - إعدادات الاتصال بـ Supabase و Google OAuth
# =====================================================================

# رابط مشروع Supabase (مثال: https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# المفتاح العام Anon/Public Key (آمن للاستخدام في التطبيق)
# تحذير: لا تضع أبداً مفتاح service_role هنا!
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# معرف عميل Google OAuth للتحقق من تسجيل الدخول
GOOGLE_OAUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# البريد الإلكتروني الحصري لمالك ومدير التطبيق
ADMIN_EMAIL=m91857687@gmail.com
